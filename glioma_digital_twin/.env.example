# Supabase Configuration
# Optional: If omitted, the system automatically uses the persistent local/offline SQLite & In-Memory Client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501

# Model Checkpoints & Storage
OFFLINE_MODE=True
DEVICE=cpu
DATA_DIR=./data
CHECKPOINTS_DIR=./checkpoints
